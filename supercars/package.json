{
  "name": "supercars",
  "version": "0.1.0",
  "private": true,
  "description": "SuperCars — personalised automotive artwork storefront (prototype)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "headers:write": "node scripts/write-headers.mjs",
    "og": "node scripts/generate-og.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "audit:code": "node scripts/audit-code.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:dryrun": "wrangler deploy --dry-run --outdir .wrangler/dryrun",
    "verify": "npm run lint && npm run typecheck && npm test && npm run check:secrets && npm run audit:code && npm run build && npm run check:bundle",
    "photos:fetch": "node scripts/fetch-photos.mjs",
    "photos:process": "node scripts/process-photos.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opennextjs/cloudflare": "^1.20.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "postcss": "^8.5.28",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  },
  "type": "module"
}
